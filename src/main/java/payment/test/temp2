Для простоты сборки JSON и извлечения ссылки в примере используется базовая работа со строками, чтобы вам не пришлось обязательно ставить тяжелые сторонние библиотеки.
java
import java.awt.Desktop;
import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;
import java.time.Instant;

public class WebPayPaymentService {

    // Тестовый URL для JSON API. Для боевой среды замените на https://payment.webpay.by/api/v1/payment
    private static final String WEBPAY_API_URL = "https://securesandbox.webpay.by/api/v1/payment";

    // Вставьте ваш секретный ключ из личного кабинета WebPay. Для тестов часто используется "1"
    private static final String SECRET_KEY = "1";

    public void processPayment() {
        try {
            // Динамические параметры платежа
            String storeId = "11111111";
            String orderNum = "ORDER-" + Instant.now().getEpochSecond(); // Уникальный номер заказа
            String currency = "BYN";
            int testMode = 1; // 1 - тест, 0 - реальная оплата
            String totalAmount = "31.4"; // Сумма
            String seed = String.valueOf(Instant.now().getEpochSecond()); // Уникальное число (Unix Timestamp)

            // Генерируем валидную подпись wsb_signature
            String signature = WebPaySigner.computeSignature(
                    seed, storeId, orderNum, testMode, currency, totalAmount, SECRET_KEY
            );

            // Формируем тело JSON-запроса
            String jsonBody = "{\n" +
                    "  \"wsb_storeid\": \"" + storeId + "\",\n" +
                    "  \"wsb_order_num\": \"" + orderNum + "\",\n" +
                    "  \"wsb_currency_id\": \"" + currency + "\",\n" +
                    "  \"wsb_version\": 2,\n" +
                    "  \"wsb_seed\": \"" + seed + "\",\n" +
                    "  \"wsb_test\": " + testMode + ",\n" +
                    "  \"wsb_invoice_item_name\": [\"Товар 1\", \"Товар 2\"],\n" +
                    "  \"wsb_invoice_item_quantity\": [2, 1],\n" +
                    "  \"wsb_invoice_item_price\": [10, 0.5],\n" +
                    "  \"wsb_total\": " + totalAmount + ",\n" +
                    "  \"wsb_signature\": \"" + signature + "\"\n" +
                    "}";

            // Отправляем H2H POST-запрос на шлюз WebPay
            HttpClient client = HttpClient.newHttpClient();
            HttpRequest request = HttpRequest.newBuilder()
                    .uri(URI.create(WEBPAY_API_URL))
                    .header("Content-Type", "application/json")
                    .header("Accept", "application/json")
                    .POST(HttpRequest.BodyPublishers.ofString(jsonBody))
                    .build();

            System.out.println("Отправка H2H запроса на создание платежной сессии...");
            HttpResponse<String> response = client.send(request, HttpResponse.BodyHandlers.ofString());

            if (response.statusCode() == 200) {
                String responseBody = response.body();
                System.out.println("Ответ от WebPay получен успешно!");

                // Извлекаем redirectUrl из JSON-ответа WebPay
                // (Рекомендуется использовать Jackson/Gson, ниже — быстрый поиск строки)
                String redirectUrl = parseRedirectUrl(responseBody);

                if (redirectUrl != null && !redirectUrl.isEmpty()) {
                    System.out.println("Перенаправляем пользователя на форму ввода карты: " + redirectUrl);

                    // ОТКРЫВАЕМ БРАУЗЕР ПОЛЬЗОВАТЕЛЯ
                    if (Desktop.isDesktopSupported()) {
                        Desktop.getDesktop().browse(new URI(redirectUrl));
                    }
                } else {
                    System.err.println("В ответе API не найден redirectUrl. Сырой ответ: " + responseBody);
                }
            } else {
                System.err.println("Ошибка API WebPay. Код ответа: " + response.statusCode());
                System.err.println("Детали: " + response.body());
            }

        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    // Простой вспомогательный метод для поиска ссылки без сторонних библиотек
    private String parseRedirectUrl(String json) {
        if (!json.contains("redirectUrl")) return null;
        int start = json.indexOf("redirectUrl\":\"") + "redirectUrl\":\"".length();
        int end = json.indexOf("\"", start);
        return json.substring(start, end).replace("\\/", "/"); // Убираем экранирование слэшей
    }
}

import java.awt.Desktop;
import java.io.File;
import java.io.FileWriter;
import java.time.Instant;
import java.util.UUID;

public class WebPayPaymentService {

    private static final String WEBPAY_POST_URL = "https://securesandbox.webpay.by/";
    private static final String SECRET_KEY = "1"; // Ваш тестовый секретный ключ

    public void processPayment() {
        try {
            // 1. ГЕНЕРИРУЕМ ПАРАМЕТРЫ ПЛАТЕЖА
            String storeId = "11111111";
            String currency = "BYN";
            int testMode = 1;
            String totalAmount = "20"; // Сумма (строго целое число для теста)

            // ГАРАНТИРУЕМ 100% УНИКАЛЬНОСТЬ: генерируем данные ОДИН раз в локальные переменные
            String seed = String.valueOf(Instant.now().getEpochSecond());
            // Создаем UUID и берем первые 10 символов, чтобы номер не был слишком длинным
            String orderNum = "ORD-" + UUID.randomUUID().toString().substring(0, 10);

            // 2. РАССЧИТЫВАЕМ ПОДПИСЬ СТРОГО ИЗ ЭТИХ ЖЕ ПЕРЕМЕННЫХ
            String signature = WebPaySigner.computeSignature(
                    seed, storeId, orderNum, testMode, currency, totalAmount, SECRET_KEY
            );

            // Выведем в консоль для контроля, что номер действительно уникальный
            System.out.println("[Java App] Отправляем уникальный заказ: " + orderNum);
            System.out.println("[Java App] Сгенерированная подпись signature: " + signature);

            // 3. СТРОИМ HTML ФОРМУ
            StringBuilder html = new StringBuilder();
            html.append("<!DOCTYPE html><html><head><meta charset='UTF-8'><title>Перенаправление...</title></head>");
            html.append("<body onload='document.forms[0].submit()'>"); // Явный автосабмит первой формы
            html.append("<form action='").append(WEBPAY_POST_URL).append("' method='POST'>");

            // Передаем параметры ИДЕНТИЧНЫЕ тем, что пошли в подпись
            html.append("<input type='hidden' name='wsb_version' value='2'>");
            html.append("<input type='hidden' name='wsb_language_id' value='russian'>");
            html.append("<input type='hidden' name='wsb_storeid' value='").append(storeId).append("'>");
            html.append("<input type='hidden' name='wsb_order_num' value='").append(orderNum).append("'>");
            html.append("<input type='hidden' name='wsb_currency_id' value='").append(currency).append("'>");
            html.append("<input type='hidden' name='wsb_seed' value='").append(seed).append("'>");
            html.append("<input type='hidden' name='wsb_test' value='").append(testMode).append("'>");
            html.append("<input type='hidden' name='wsb_total' value='").append(totalAmount).append("'>");
            html.append("<input type='hidden' name='wsb_signature' value='").append(signature).append("'>");

            // Данные товара (10 рублей * 2 штуки = 20 рублей)
            html.append("<input type='hidden' name='wsb_invoice_item_name' value='Тестовый Товар'>");
            html.append("<input type='hidden' name='wsb_invoice_item_quantity' value='2'>");
            html.append("<input type='hidden' name='wsb_invoice_item_price' value='10'>");

            html.append("</form></body></html>");

            // 4. ЗАПИСЬ ВО ВРЕМЕННЫЙ ФАЙЛ
            File tempHtmlFile = File.createTempFile("webpay_pay_", ".html");
            tempHtmlFile.deleteOnExit();

            try (FileWriter writer = new FileWriter(tempHtmlFile)) {
                writer.write(html.toString());
            }

            // 5. ОТКРЫТИЕ БРАУЗЕРА
            if (Desktop.isDesktopSupported() && Desktop.getDesktop().isSupported(Desktop.Action.BROWSE)) {
                Desktop.getDesktop().browse(tempHtmlFile.toURI());
            }

        } catch (Exception e) {
            e.printStackTrace();
        }
    }
}

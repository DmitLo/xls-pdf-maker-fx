import java.awt.Desktop;
import java.io.File;
import java.io.FileWriter;
import java.io.OutputStream;
import java.net.InetSocketAddress;
import java.net.URI;
import java.time.Instant;
import com.sun.net.httpserver.HttpServer; // Встроенный в Java сервер

public class WebPayPaymentService {

    private static final String WEBPAY_POST_URL = "https://webpay.by";
    private static final String SECRET_KEY = "1";

    private HttpServer server;

    public void processPayment() {
        try {
            // 1. ЗАПУСКАЕМ ЛОКАЛЬНЫЙ СЕРВЕР ДЛЯ ОТЛОВЛИ ВОЗВРАТА
            startLocalServer();

            // 2. ПАРАМЕТРЫ ПЛАТЕЖА
            String storeId = "11111111";
            String orderNum = "ORDER-" + Instant.now().getEpochSecond();
            String currency = "BYN";
            int testMode = 1;
            String totalAmount = "31.4";
            String seed = String.valueOf(Instant.now().getEpochSecond());

            // Ссылки возврата ведут на наш локальный сервер в Java!
            String returnUrl = "http://localhost:8080/success";
            String cancelUrl = "http://localhost:8080/cancel";

            // Считаем подпись (Внимание: если в вашей версии API WebPay адреса возврата
            // участвуют в подписи, добавьте их в WebPaySigner. Для v2 обычно склеиваются только базовые поля)
            String signature = WebPaySigner.computeSignature(
                    seed, storeId, orderNum, testMode, currency, totalAmount, SECRET_KEY
            );

            // 3. ГЕНЕРИРУЕМ HTML С ПОЛЯМИ ВОЗВРАТА
            StringBuilder html = new StringBuilder();
            html.append("<html><head><title>Перенаправление...</title></head>");
            html.append("<body onload='document.forms[0].submit()'>"); // Авто-клик кнопки
            html.append("<form action='").append(WEBPAY_POST_URL).append("' method='POST'>");

            // Основные поля
            html.append("<input type='hidden' name='wsb_storeid' value='").append(storeId).append("'>");
            html.append("<input type='hidden' name='wsb_order_num' value='").append(orderNum).append("'>");
            html.append("<input type='hidden' name='wsb_currency_id' value='").append(currency).append("'>");
            html.append("<input type='hidden' name='wsb_version' value='2'>");
            html.append("<input type='hidden' name='wsb_seed' value='").append(seed).append("'>");
            html.append("<input type='hidden' name='wsb_test' value='").append(testMode).append("'>");
            html.append("<input type='hidden' name='wsb_total' value='").append(totalAmount).append("'>");
            html.append("<input type='hidden' name='wsb_signature' value='").append(signature).append("'>");

            // Ссылки возврата для WebPay
            html.append("<input type='hidden' name='wsb_return_url' value='").append(returnUrl).append("'>");
            html.append("<input type='hidden' name='wsb_cancel_url' value='").append(cancelUrl).append("'>");

            // Корзина товаров
            html.append("<input type='hidden' name='wsb_invoice_item_name[]' value='Товар 1'>");
            html.append("<input type='hidden' name='wsb_invoice_item_quantity[]' value='2'>");
            html.append("<input type='hidden' name='wsb_invoice_item_price[]' value='10'>");
            html.append("<input type='hidden' name='wsb_invoice_item_name[]' value='Товар 2'>");
            html.append("<input type='hidden' name='wsb_invoice_item_quantity[]' value='1'>");
            html.append("<input type='hidden' name='wsb_invoice_item_price[]' value='0.5'>");

            html.append("</form></body></html>");

            // 4. СОХРАНЯЕМ И ОТКРЫВАЕМ
            File tempHtmlFile = File.createTempFile("webpay_form_", ".html");
            tempHtmlFile.deleteOnExit();

            try (FileWriter writer = new FileWriter(tempHtmlFile)) {
                writer.write(html.toString());
            }

            System.out.println("Форма готова. Ожидаем оплату в браузере...");
            if (Desktop.isDesktopSupported()) {
                Desktop.getDesktop().browse(tempHtmlFile.toURI());
            }

        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    /**
     * Запуск фонового мини-сервера в приложении
     */
    private void startLocalServer() throws Exception {
        // Создаем сервер на порту 8080
        server = HttpServer.create(new InetSocketAddress(8080), 0);

        // Обработчик успешной оплаты
        server.createContext("/success", exchange -> {
            System.out.println("\n[Java App] Сигнал получен: Оплата прошла успешно!");

            // HTML-ответ, который увидит пользователь в браузере
            String response = "<html><body><h1 style='color:green; text-align:center; margin-top:50px;'>"
                    + "Успешно! Возвращайтесь в приложение.</h1></body></html>";

            byte[] bytes = response.getBytes("UTF-8");
            exchange.getResponseHeaders().set("Content-Type", "text/html; charset=UTF-8");
            exchange.sendResponseHeaders(200, bytes.length);
            try (OutputStream os = exchange.getResponseBody()) {
                os.write(bytes);
            }

            // ТУТ ВАШ КОД: Например, вызвать метод updateUIForSuccess()
            // чтобы разблокировать функции в десктопном интерфейсе

            stopServer(); // Выключаем сервер за ненадобностью
        });

        // Обработчик отмены оплаты
        server.createContext("/cancel", exchange -> {
            System.out.println("\n[Java App] Сигнал получен: Пользователь отменил оплату.");

            String response = "<html><body><h1 style='color:red; text-align:center; margin-top:50px;'>"
                    + "Оплата отменена. Вы можете закрыть вкладку.</h1></body></html>";

            byte[] bytes = response.getBytes("UTF-8");
            exchange.getResponseHeaders().set("Content-Type", "text/html; charset=UTF-8");
            exchange.sendResponseHeaders(200, bytes.length);
            try (OutputStream os = exchange.getResponseBody()) {
                os.write(bytes);
            }

            stopServer();
        });

        server.setExecutor(null); // Дефолтный исполнитель
        server.start();
    }

    private void stopServer() {
        if (server != null) {
            server.stop(1); // Остановить сервер через 1 секунду
            System.out.println("Локальный сервер Java остановлен.");
        }
    }
}
